// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())

  threads   Thread[] @relation("userThreads")
}

model EjentoConfig {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  baseUrl     String
  apiKey      String
  ejentoAccessToken String?
  agentId     Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Session{
  id Int @id @default(autoincrement())
  sessionId String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  threads Thread[] @relation("sessionThreads")
}

model Thread{
  id Int @id @default(autoincrement()) // Local DB ID
  title String
  ownerType ownerType
  ownerUserId Int?
  ownerSessionId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metaData Json?
  externalApiId Int? @unique // The REAL ID from external API (dev.ejento.ai)

  messages Message[] 

  ownerUser User? @relation("userThreads",fields : [ownerUserId], references : [id])
  ownerSession Session? @relation("sessionThreads",fields : [ownerSessionId], references : [id])
}

model Message { 
  id Int @id @default(autoincrement()) 
  threadId Int 
  role Role 
  content String 
  createdAt DateTime @default(now()) 
  agent_response_id Int? @unique
  metadata Json? 
  
  thread Thread @relation(fields: [threadId], references: [id],  onDelete: Cascade) 

}


enum ownerType{
   user
   session
}

enum Role{
  user
  assistant
}
